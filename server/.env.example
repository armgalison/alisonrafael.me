PORT=3000
CORS_ORIGIN=https://alisonrafael.me,https://www.alisonrafael.me

DB_HOST=localhost
DB_PORT=3306
DB_USER=alisonrafael
DB_PASSWORD=change-me
DB_NAME=alisonrafael
DB_ROOT_PASSWORD=root-password

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400

# Seeds the single admin account on first boot only (skipped if an admin
# already exists). Change the password via a future admin flow, not by
# editing these — they're not re-applied after the first successful boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Powers the "Get top trends" feature (see ADR 0007) — trend discovery via
# Claude's web_search tool, and draft-post generation. Get a key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-change-me
