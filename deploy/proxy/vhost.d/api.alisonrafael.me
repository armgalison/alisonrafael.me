# Per-vhost nginx-proxy override (docker-gen picks up files here named
# exactly after the VIRTUAL_HOST). The trend-discovery/draft-creation
# endpoints run multiple chained Claude calls with web search and can take
# well over nginx-proxy's 60s default — see ADR 0007.
proxy_connect_timeout 180s;
proxy_send_timeout 180s;
proxy_read_timeout 180s;
