# Deploy-time secrets for `docker compose up -d` on the droplet.
# Copy to `.env` in the same directory as docker-compose.yml (never commit
# the real `.env`) — compose loads it automatically.
#
# For local development without Docker, see server/.env.example instead.

DB_ROOT_PASSWORD=change-me
DB_USER=alisonrafael
DB_PASSWORD=change-me
DB_NAME=alisonrafael

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400

# Seeds the single admin account on first boot only (skipped if an admin
# already exists in the database).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
