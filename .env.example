# Deploy-time secrets for `docker compose up -d` on the droplet.
#
# In production this file is generated automatically by
# .github/workflows/deploy.yml from GitHub Actions repo secrets (Settings →
# Secrets and variables → Actions) on every deploy — nobody edits it by hand
# on the droplet. Required secrets: DB_ROOT_PASSWORD, DB_PASSWORD, JWT_SECRET,
# ADMIN_EMAIL, ADMIN_PASSWORD, ANTHROPIC_API_KEY.
#
# This file itself is just documentation/a local-testing template — copy it
# to `.env` next to docker-compose.yml if you want to run `docker compose up`
# by hand (e.g. testing locally); never commit the real `.env`.
#
# For local development without Docker, see server/.env.example instead.

DB_ROOT_PASSWORD=change-me
DB_USER=alisonrafael
DB_PASSWORD=change-me
DB_NAME=alisonrafael

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=86400

# Seeds the single admin account on first boot only (skipped if an admin
# already exists in the database).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Powers "Get top trends" (see ADR 0007). Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-change-me
